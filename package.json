{
  "name": "@molecare/react-photo-compare",
  "version": "0.1.0",
  "description": "Two photos side by side with one shared zoom and pan, for React. Drag, pinch, scroll or use the keyboard; zoom one and the other follows. No dependencies, SSR-safe, unstyled.",
  "license": "Apache-2.0",
  "author": "MoleCare LTD <info@molecare.co.uk> (https://www.molecare.co.uk)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoleCare/react-photo-compare.git"
  },
  "bugs": {
    "url": "https://github.com/MoleCare/react-photo-compare/issues"
  },
  "homepage": "https://github.com/MoleCare/react-photo-compare#readme",
  "keywords": [
    "react",
    "image-compare",
    "photo-compare",
    "side-by-side",
    "zoom",
    "pan",
    "pinch-zoom",
    "synchronized",
    "before-after",
    "accessibility",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!**/__tests__",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "clean": "del-cli dist coverage",
    "prepack": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "jest",
    "check:package": "tsup && publint --strict && attw --pack .",
    "check:consumer": "bash scripts/check-consumer.sh"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "printWidth": 100
  },
  "jest": {
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/__tests__"
    ],
    "collectCoverageFrom": [
      "<rootDir>/src/**/*.{ts,tsx}",
      "!<rootDir>/src/index.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-jest": "^30.5.2",
    "del-cli": "^7.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.9",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
